---
/**
 * AureliaLogo
 * Technique : le conteneur garde une taille fixe dans le layout,
 * l'image est agrandie par scale() + overflow visible pour
 * apparaître plus grande visuellement sans modifier la navbar.
 */
export interface Props {
  size?: 'navbar' | 'footer' | 'page' | string;
  class?: string;
}
const { size = 'footer', class: extra = '' } = Astro.props;
---

{size === 'navbar' ? (
  <!--
    Navbar : conteneur de 48px de hauteur dans le flux,
    image agrandie à 2.8× par transform:scale pour être bien visible.
    overflow:visible permet à l'image d'être plus grande que son conteneur
    sans affecter la taille de la navbar.
  -->
  <div
    class={`relative flex items-center flex-none shrink-0 ${extra}`}
    style="height:48px; width:150px;"
  >
    <img
      src="/illustrations/aurelia_automation_it_services_logo.jpg"
      alt="Aurelia Automation & IT Services"
      loading="eager"
      decoding="async"
      style="
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%) scale(2.8);
        transform-origin: center center;
        width: 150px;
        height: 48px;
        object-fit: contain;
        pointer-events: none;
      "
    />
  </div>
) : size === 'footer' ? (
  <img
    src="/illustrations/aurelia_automation_it_services_logo.jpg"
    alt="Aurelia Automation & IT Services"
    loading="lazy"
    decoding="async"
    style="width:200px; height:60px; object-fit:contain; display:block;"
    class={extra}
  />
) : (
  <img
    src="/illustrations/aurelia_automation_it_services_logo.jpg"
    alt="Aurelia Automation & IT Services"
    loading="lazy"
    decoding="async"
    style="width:260px; height:78px; object-fit:contain; display:block;"
    class={extra}
  />
)}
