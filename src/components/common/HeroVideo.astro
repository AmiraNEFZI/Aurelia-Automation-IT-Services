---
// Hero image — SCADA réelle fournie par le client
const heroImageSrc = '/illustrations/scada.jpg';
const heroImageAlt = 'SCADA & Industrial Automation Systems — Aurelia Automation & IT Services';
---

<div class="relative mx-auto w-full pt-8 sm:w-[94%]">

  {/* Fade vers le bas */}
  <div class="pointer-events-none absolute inset-x-0 -bottom-1 z-10 hidden h-16 w-full sm:block"
       style="background: linear-gradient(to bottom, transparent, white)"></div>

  {/* Badge stat — gauche */}
  <div class="absolute -left-3 top-[18%] z-20 hidden sm:block">
    <div class="rounded-2xl bg-white px-4 py-3 shadow-xl border border-brand-100" style="min-width:140px">
      <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Production OEE</p>
      <p class="text-2xl font-black text-brand-700 leading-none mt-1">+32%</p>
      <p class="text-[10px] text-teal-600 font-semibold mt-1">▲ after automation</p>
    </div>
  </div>

  {/* Badge stat — droite */}
  <div class="absolute -right-3 bottom-[20%] z-20 hidden sm:block">
    <div class="rounded-2xl bg-white px-4 py-3 shadow-xl border border-teal-100" style="min-width:150px">
      <p class="text-[10px] font-bold text-slate-400 uppercase tracking-wider">Downtime Reduced</p>
      <p class="text-2xl font-black text-teal-700 leading-none mt-1">−45%</p>
      <p class="text-[10px] text-brand-600 font-semibold mt-1">▲ vs. pre-deployment</p>
    </div>
  </div>

  {/* Image principale SCADA */}
  <div class="overflow-hidden rounded-3xl shadow-2xl" style="border: 2px solid #e0e8f4">
    <img
      src={heroImageSrc}
      alt={heroImageAlt}
      class="block w-full h-auto"
      style="max-height: 520px; object-fit: cover; object-position: center;"
      loading="eager"
      decoding="async"
    />
  </div>

  {/* Pills secteurs */}
  <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
    {['Automotive', 'Pharmaceuticals', 'Energy', 'Agri-food', 'Logistics'].map(s => (
      <span class="rounded-full bg-white border border-brand-100 px-4 py-1.5 text-xs font-semibold text-brand-700 shadow-sm">
        {s}
      </span>
    ))}
  </div>

</div>
