---
import Icon from '@ui/icons/Icon.astro';
---
<div class="flex justify-center">
  <div class="rounded-xl bg-slate-50 shadow-md">
    <a
      href="/partenaires"
      class="group flex h-9 w-fit items-center justify-center gap-0 rounded-xl transition duration-300"
      aria-label="Représentant exclusif ERP LogieMAX en Afrique du Nord"
    >
      <div class="flex h-full w-fit items-center gap-2 rounded-xl bg-brand-700 px-3">
        <span class="text-sm font-semibold text-white">Industrie 4.0</span>
      </div>
      <div class="hidden h-full w-fit items-center justify-center gap-2 px-3 sm:flex">
        <span class="text-sm text-slate-600 transition duration-300 group-hover:underline">
          Représentant exclusif ERP LogieMAX en Afrique du Nord
        </span>
        <Icon name="chevronRight" />
      </div>
    </a>
  </div>
</div>
