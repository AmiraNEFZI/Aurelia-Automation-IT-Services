---
const title   = `Our <span class="text-teal-600">Core</span> <span class="text-brand-700">Expertise</span>`;
const subTitle = `Three integrated service pillars that turn your industrial operations into a high-performance, data-driven and future-ready enterprise.`;
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20">

  <!-- Section header -->
  <div class="mx-auto mb-12 max-w-2xl text-center">
    <h2 class="text-2xl font-semibold text-balance text-slate-800 md:text-3xl md:leading-tight">
      <Fragment set:html={title} />
    </h2>
    <p class="mt-3 text-pretty text-slate-500">{subTitle}</p>
  </div>

  <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">

    <!-- ══════════════════════════════════════════
         CARD 1 — Industrial Automation (full width)
         Image: /illustrations/industrial-automation.svg  [GARDÉE]
    ══════════════════════════════════════════ -->
    <div class="lg:col-span-3 group relative overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm hover:shadow-xl transition-all duration-300">
      <div class="grid md:grid-cols-2 items-stretch">
        <!-- Text side -->
        <div class="flex flex-col justify-center p-8 md:p-10">
          <span class="inline-block rounded-full bg-brand-50 px-3 py-1 text-xs font-bold text-brand-700 tracking-widest uppercase mb-4">
            Robotics · PLCs · SCADA
          </span>
          <h3 class="text-2xl font-bold text-slate-800 mb-3">Industrial Automation</h3>
          <p class="text-slate-600 text-base leading-relaxed">
            Installation and maintenance of robotic systems, PLCs and SCADA networks, ensuring efficient production and reduced downtime across your entire facility.
          </p>
          <a href="/services" class="mt-6 inline-flex items-center gap-2 text-sm font-semibold text-brand-700 hover:gap-3 transition-all">
            Learn more
            <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg>
          </a>
        </div>
        <!-- Image side -->
        <div class="min-h-[280px] overflow-hidden bg-slate-50">
          <img
            src="/illustrations/industrial-automation.svg"
            alt="Industrial automation — robotic arms and PLC controller"
            class="h-full w-full object-cover"
            loading="lazy"
          />
        </div>
      </div>
      <div class="absolute top-0 left-0 w-1.5 h-full bg-brand-700 rounded-l-2xl"></div>
    </div>

    <!-- ══════════════════════════════════════════
         CARD 2 — IoT & AI Integration (dark, 2/3 width)
         Image: /illustrations/iot-ai-integration.svg  [GARDÉE]
    ══════════════════════════════════════════ -->
    <div class="lg:col-span-2 group relative overflow-hidden rounded-2xl bg-slate-900 shadow-sm hover:shadow-2xl transition-all duration-300">
      <!-- Image top -->
      <div class="relative h-56 overflow-hidden">
        <img
          src="/illustrations/iot-ai-integration.svg"
          alt="IoT and AI integration — smart factory sensors and data"
          class="h-full w-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-linear-to-b from-transparent to-slate-900/60"></div>
      </div>
      <!-- Text -->
      <div class="p-8">
        <span class="inline-block rounded-full bg-teal-900/60 px-3 py-1 text-xs font-bold text-teal-400 tracking-widest uppercase mb-3">
          Smart Factory · Predictive Analytics
        </span>
        <h3 class="text-xl font-bold text-white mb-2">IoT &amp; AI Integration</h3>
        <p class="text-slate-400 text-sm leading-relaxed">
          Deployment of <strong class="text-teal-400">IoT</strong> and <strong class="text-teal-400">artificial intelligence</strong> solutions to modernise industrial processes, improve data collection and facilitate informed decision-making.
        </p>
        <a href="/services" class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-teal-400 hover:gap-3 transition-all">
          Learn more
          <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg>
        </a>
      </div>
      <div class="absolute top-0 left-0 w-1.5 h-full bg-teal-500 rounded-l-2xl"></div>
    </div>

    <!-- ══════════════════════════════════════════
         CARD 3 — Power BI Consulting (1/3 width)
         Remplacé par un visuel HTML natif (SVG externe cassé)
    ══════════════════════════════════════════ -->
    <div class="lg:col-span-1 group relative overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-sm hover:shadow-xl transition-all duration-300">
      <!-- Power BI visual — HTML natif, zéro dépendance externe -->
      <div class="relative h-56 overflow-hidden bg-slate-800 p-5 flex flex-col gap-2">
        <!-- Header bar -->
        <div class="flex items-center justify-between mb-1">
          <span class="text-xs font-bold text-white/80 uppercase tracking-widest">Power BI Dashboard</span>
          <span class="rounded bg-[#F2C811] px-2 py-0.5 text-[10px] font-black text-slate-900">Power BI</span>
        </div>
        <!-- KPI row -->
        <div class="grid grid-cols-2 gap-2">
          <div class="rounded-lg bg-brand-700/80 p-2.5">
            <p class="text-[10px] text-blue-200">OEE Score</p>
            <p class="text-xl font-black text-white">94.7%</p>
            <p class="text-[9px] text-green-400">▲ +3.2%</p>
          </div>
          <div class="rounded-lg bg-teal-800/80 p-2.5">
            <p class="text-[10px] text-teal-200">Output/day</p>
            <p class="text-xl font-black text-white">12,847</p>
            <p class="text-[9px] text-green-400">▲ +8.4%</p>
          </div>
        </div>
        <!-- Mini bar chart -->
        <div class="mt-1 flex items-end gap-1.5 h-14">
          {[40,65,50,80,70,95,85,100].map((pct, i) => (
            <div
              class={`flex-1 rounded-sm ${i % 2 === 0 ? 'bg-brand-500' : 'bg-teal-500'}`}
              style={`height:${pct}%`}
            ></div>
          ))}
        </div>
        <p class="text-[9px] text-slate-400 text-center mt-0.5">Production by Line — Last 8 shifts</p>
      </div>
      <!-- Text -->
      <div class="p-7">
        <span class="inline-block rounded-full bg-teal-50 px-3 py-1 text-xs font-bold text-teal-700 tracking-widest uppercase mb-3">
          Dashboards · KPIs · Reports
        </span>
        <h3 class="text-xl font-bold text-slate-800 mb-2">Power BI Consulting</h3>
        <p class="text-slate-600 text-sm leading-relaxed">
          Designing customised, interactive dashboards, transforming raw data into strategic information for better performance management.
        </p>
        <a href="/services" class="mt-5 inline-flex items-center gap-2 text-sm font-semibold text-brand-700 hover:gap-3 transition-all">
          Learn more
          <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg>
        </a>
      </div>
      <div class="absolute top-0 left-0 w-1.5 h-full bg-[#F2C811] rounded-l-2xl"></div>
    </div>

    <!-- ══════════════════════════════════════════
         CARD 4 — And more (full width bottom)
    ══════════════════════════════════════════ -->
    <div class="lg:col-span-3 rounded-2xl border border-dashed border-brand-200 bg-brand-50 p-8 md:p-10">
      <h3 class="text-xl font-bold text-brand-800 mb-6">And more…</h3>
      <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        {[
          'Serving automotive, pharmaceuticals, energy, agri-food & logistics',
          'Ethical technology that improves productivity while protecting your team',
          'End-to-end project management from audit to production go-live',
          'Independent approach — no vendor lock-in, no one-size-fits-all',
        ].map(item => (
          <li class="flex items-start gap-3 text-slate-700">
            <svg class="mt-0.5 size-5 shrink-0 text-teal-600" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
            </svg>
            <span class="text-sm">{item}</span>
          </li>
        ))}
      </ul>
    </div>

  </div>
</section>
