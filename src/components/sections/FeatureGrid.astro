---
import Icon from '@ui/icons/Icon.astro';

const title    = 'Why choose <span class="text-brand-700">Aurelia</span>?';
const subTitle = 'Our independent and innovative approach sets us apart. We deliver tailor-made solutions — no vendor lock-in, no one-size-fits-all — just the right technology, properly implemented, to genuinely transform your operations and protect your people.';

const features = [
  {
    borderClasses:   'md:border-l md:border-r',
    gradientClasses: 'bg-linear-to-l/oklch from-brand-100 to-transparent',
    icon:    'cursorRays',
    heading: 'Independent & Innovative',
    description: 'No vendor lock-in. Our engineering team selects the best-fit technology for your specific context, budget and sector — from robotics and PLCs to cloud-native AI platforms.',
  },
  {
    borderClasses:   'border-b border-t md:border-b-0',
    gridClasses:     'md:col-start-2 md:col-end-3',
    gradientClasses: 'bg-linear-to-t/oklch from-teal-100 to-transparent',
    icon:    'cog',
    heading: 'Industry 4.0 Specialists',
    description: 'From SCADA and PLC programming to IoT sensor networks and machine-learning pipelines, we bring deep industrial automation expertise to every project we take on.',
  },
  {
    borderClasses:   'md:border-l md:border-r md:border-t',
    gridClasses:     'md:col-end-4',
    gradientClasses: 'bg-linear-to-tl/oklch from-brand-100 to-transparent',
    icon:    'puzzle',
    heading: 'Safety & Ethics First',
    description: 'We are committed to technology solutions that improve productivity while ensuring employee safety — a non-negotiable principle embedded in every system we design and deploy.',
  },
];
---

<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20">
  <div class="grid grid-flow-row-dense grid-cols-1 md:grid-cols-3 md:grid-rows-2">
    <div class="mx-auto max-w-lg pb-5 text-center md:col-span-2 lg:mx-0 lg:flex-auto lg:text-left">
      <h2 class="text-2xl font-semibold tracking-tight text-balance text-slate-800 md:text-3xl md:leading-tight">
        <Fragment set:html={title} />
      </h2>
      <p class="mt-6 text-start text-lg/8 text-pretty text-slate-700 sm:text-center md:text-start">
        {subTitle}
      </p>
    </div>

    {features.map(feature => (
      <div class={`group relative mx-auto flex flex-col border-dashed border-slate-400 py-10 ${feature.borderClasses} ${feature.gridClasses ?? ''}`}>
        <div class={`pointer-events-none absolute inset-0 h-full w-full ${feature.gradientClasses} opacity-0 transition duration-300 group-hover:opacity-100`}/>
        <div class="relative z-10 mb-4 px-10"><Icon name={feature.icon} /></div>
        <div class="relative z-10 mb-2 px-10 text-lg font-semibold">
          <span class="inline-block text-balance text-slate-800 transition duration-300 group-hover:translate-x-2">{feature.heading}</span>
        </div>
        <p class="z-10 max-w-sm px-4 text-sm text-pretty text-slate-700 sm:max-w-lg md:mx-auto">{feature.description}</p>
      </div>
    ))}
  </div>
</section>
