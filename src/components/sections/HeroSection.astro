---
import AnnouncementBanner from '@common/AnnouncementBanner.astro';
import HeroContent from '@common/HeroContent.astro';
import HeroVideo from '@common/HeroVideo.astro';
---

<section class="relative overflow-hidden bg-white">
  {/* Decorative background — brand blue top + white bottom */}
  <div class="absolute inset-0 -z-10">
    <div class="absolute inset-x-0 top-0 h-[520px] bg-linear-to-b/oklch from-brand-50 via-slate-50 to-white"></div>
    {/* Soft radial glows */}
    <div class="absolute -top-20 -left-20 h-96 w-96 rounded-full bg-brand-100 opacity-30 blur-3xl"></div>
    <div class="absolute -top-10 -right-10 h-80 w-80 rounded-full bg-teal-100 opacity-25 blur-3xl"></div>
  </div>

  <div class="mx-auto max-w-[85rem] space-y-10 px-4 pt-44 pb-16 sm:px-6 lg:px-8">
    <AnnouncementBanner />
    <HeroContent />
    <HeroVideo />
  </div>
</section>
