---
import Button from '@ui/Button.astro';
import AureliaLogo from '@common/AureliaLogo.astro';
import { navigationLinks } from '@utils/navigation';

const currentPath = Astro.url.pathname;
---

<header
  class="fixed start-1/2 top-3 z-50 mx-auto w-[calc(100%-2rem)] max-w-sm -translate-x-1/2 rounded-2xl border border-slate-100 bg-white/98 backdrop-blur-md shadow-lg sm:max-w-2xl md:max-w-4xl lg:max-w-5xl xl:max-w-[78rem]"
>
  <nav class="flex items-center justify-between gap-4 px-4 py-2 sm:px-6">

    <!-- LOGO — conteneur taille fixe pour éviter tout rognage -->
    <a
      href="/"
      aria-label="Aurelia Automation & IT Services — Home"
      class="flex-none shrink-0 focus:outline-hidden focus:opacity-80"
    >
      <AureliaLogo size="navbar" />
    </a>

    <!-- LIENS DESKTOP -->
    <div class="hidden xl:flex xl:flex-1 xl:items-center xl:justify-center xl:gap-1">
      <a href="/"
        class={`rounded-lg px-3 py-2 text-sm font-semibold transition-colors hover:bg-brand-50 hover:text-brand-700 ${currentPath === '/' ? 'bg-brand-50 text-brand-700' : 'text-slate-700'}`}
        aria-current={currentPath === '/' ? 'page' : undefined}>Home</a>
      {navigationLinks.map(link => (
        <a href={link.href}
          class={`rounded-lg px-3 py-2 text-sm font-semibold transition-colors hover:bg-brand-50 hover:text-brand-700 ${currentPath === link.href ? 'bg-brand-50 text-brand-700' : 'text-slate-700'}`}
          aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>
      ))}
    </div>

    <!-- CTA + burger -->
    <div class="flex items-center gap-3">
      <Button href="/contact" variant="primary" className="hidden xl:inline-flex border-none py-2! px-4! text-sm! text-nowrap">
        Free Assessment
      </Button>

      <!-- Burger mobile -->
      <button
        type="button"
        class="hs-collapse-toggle flex size-9 items-center justify-center rounded-lg border border-slate-200 text-slate-700 hover:bg-slate-100 focus:outline-hidden xl:hidden"
        id="hs-header-base-collapse"
        aria-expanded="false"
        aria-controls="hs-header-base"
        aria-label="Toggle navigation"
        data-hs-collapse="#hs-header-base"
      >
        <svg class="hs-collapse-open:hidden size-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <line x1="3" x2="21" y1="6"  y2="6"/><line x1="3" x2="21" y1="12" y2="12"/><line x1="3" x2="21" y1="18" y2="18"/>
        </svg>
        <svg class="hs-collapse-open:block hidden size-5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path d="M18 6 6 18"/><path d="m6 6 12 12"/>
        </svg>
      </button>
    </div>

  </nav>

  <!-- MENU MOBILE déroulant -->
  <div
    id="hs-header-base"
    class="hs-collapse hidden overflow-hidden transition-all duration-300"
    aria-labelledby="hs-header-base-collapse"
  >
    <div class="border-t border-slate-100 px-4 py-3 space-y-1">
      <a href="/"
        class={`flex items-center rounded-lg px-3 py-2.5 text-sm font-semibold transition-colors hover:bg-brand-50 hover:text-brand-700 ${currentPath === '/' ? 'bg-brand-50 text-brand-700' : 'text-slate-700'}`}>Home</a>
      {navigationLinks.map(link => (
        <a href={link.href}
          class={`flex items-center rounded-lg px-3 py-2.5 text-sm font-semibold transition-colors hover:bg-brand-50 hover:text-brand-700 ${currentPath === link.href ? 'bg-brand-50 text-brand-700' : 'text-slate-700'}`}>{link.label}</a>
      ))}
      <div class="pt-2 pb-1">
        <Button href="/contact" variant="primary" className="w-full justify-center border-none py-2.5! text-sm!">
          Free Assessment
        </Button>
      </div>
    </div>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', async () => {
    const { HSStaticMethods } = await import('preline');
    HSStaticMethods.autoInit();
  });
</script>
