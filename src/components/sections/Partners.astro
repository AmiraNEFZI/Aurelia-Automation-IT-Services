---
const partners = [
  { name: 'CMC', logo: '/illustrations/cmc%20Tunisia%20logo.png' },
  { name: 'Aurelia Smart Food', logo: '/illustrations/Aurelia%20smartfood%20logo.jpg' },
  { name: 'ADT', logo: '/illustrations/ADT%20logo.png' },
  { name: 'STEG International Services', logo: '/illustrations/steg%20international%20services.jpg' },
  { name: 'WAVSON', logo: '/illustrations/wavson%20logo.png' },
  { name: 'RCI3D', logo: '/illustrations/RCI3D%20logo.png' },
  { name: 'Esprit', logo: '/illustrations/esprit%20logo.jpg' },
  { name: 'Alpha Technology', logo: '/illustrations/alpha_technology_logo.jpg' },
  { name: 'SOTACID Zaghouan', logo: '/illustrations/sotacid%20zaghouan.jpg' },
  { name: 'LogieMAX', logo: '/illustrations/logiemax%20logo.jpg' },
];
---

<section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8">
  <div class="text-center mb-10">
    <h2 class="text-2xl font-bold text-slate-800 md:text-3xl">
      Ils nous font <span class="text-brand-700">confiance</span>
    </h2>
    <p class="mt-2 text-slate-500 text-sm">Nos partenaires et références en Tunisie et en Afrique du Nord</p>
  </div>

  <!-- Logos row -->
  <div class="flex flex-wrap items-center justify-center gap-4">
    {partners.map(p => (
      <div class="flex items-center justify-center rounded-xl border border-slate-200 bg-white px-5 py-3 shadow-sm hover:border-brand-300 hover:shadow-md transition-all duration-200" style="min-width:110px; height:64px;">
        <img
          src={p.logo}
          alt={p.name}
          class="max-h-10 max-w-[90px] object-contain"
          loading="lazy"
          decoding="async"
          onerror={`this.style.display='none'; this.nextElementSibling.style.display='block'`}
        />
        <span class="hidden text-xs font-semibold text-slate-500 text-center">{p.name}</span>
      </div>
    ))}
  </div>

  <div class="mt-6 text-center">
    <a href="/partenaires" class="inline-flex items-center gap-2 text-sm font-semibold text-brand-700 hover:underline">
      Voir tous nos partenariats
      <svg class="size-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="m9 18 6-6-6-6"/></svg>
    </a>
  </div>
</section>
