---
const partners = [
  'CMC', 'Aurelia Smart Food', 'ADT', 'STEG International Services',
  'REACTIV', 'WAVSON', 'RCI3D', 'Esprit', 'DEAP',
  'Alpha Technology', 'SOTACID Zaghouan',
];
---

<section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8">
  <div class="text-center mb-10">
    <h2 class="text-2xl font-bold text-slate-800 md:text-3xl">
      Nos partenaires &amp; <span class="text-brand-700">nos références</span>
    </h2>
    <p class="mt-3 text-slate-500">Ils nous font confiance pour leur transformation industrielle et digitale</p>
  </div>

  <!-- Partners logo grid — text-based since no logo images available -->
  <div class="flex flex-wrap items-center justify-center gap-4">
    {partners.map(p => (
      <div class="flex items-center justify-center rounded-xl border border-slate-200 bg-white px-6 py-4 shadow-sm hover:border-brand-300 hover:shadow-md transition-all duration-200 min-w-[140px]">
        <span class="text-sm font-semibold text-slate-600 text-center">{p}</span>
      </div>
    ))}
  </div>

  <!-- Secteurs -->
  <div class="mt-14 text-center mb-6">
    <h3 class="text-xl font-bold text-slate-700">Secteurs d'activité</h3>
    <p class="mt-1 text-sm text-slate-500">Industries dans lesquelles nous intervenons</p>
  </div>
  <div class="flex flex-wrap items-center justify-center gap-3">
    {[
      'Industrie Manufacturière','Agroalimentaire','Textile & Habillement',
      'Énergie & Utilités','Industries Mécaniques','Logistique & Distribution',
      'Automotive','Pétrole & Gaz','Services IT','Banque & Assurances',
    ].map(s => (
      <span class="rounded-full border border-brand-200 bg-brand-50 px-4 py-1.5 text-xs font-semibold text-brand-700">
        {s}
      </span>
    ))}
  </div>
</section>
