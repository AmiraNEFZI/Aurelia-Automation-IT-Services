---
import Button from '@ui/Button.astro';
---
<section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 md:py-14 lg:px-8 lg:py-20">
  <div class="mx-auto mb-10 max-w-3xl text-center lg:mb-14">
    <h2 class="text-4xl text-balance text-slate-800 sm:text-5xl">
      Prêt à transformer<br/>
      <span class="text-teal-600">vos opérations industrielles ?</span>
    </h2>
    <p class="mt-5 text-lg/8 text-pretty text-slate-600">
      Contactez notre équipe pour analyser vos besoins et découvrir comment Aurelia peut
      accompagner votre transition vers l'Industrie 4.0.
    </p>
    <Button href="/contact" variant="primary" className="mt-7 inline-flex border-none px-6!">
      Nous contacter
    </Button>
  </div>
</section>
