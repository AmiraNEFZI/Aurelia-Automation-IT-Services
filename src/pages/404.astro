---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Icon from '@ui/icons/Icon.astro';
import Button from '@ui/Button.astro';
import type { WithContext, Thing } from 'schema-dts';

const page = {
  errorCode:    '404',
  title:        'Page not found',
  description:  "Sorry, we couldn't find the page you were looking for.",
  goBackLabel:  'Go back',
};

const quickLinks = [
  { title: 'Home',        description: 'Return to the homepage.',                 icon: 'cursorRays', link: '/' },
  { title: 'Services',    description: 'Explore our automation & IT services.',   icon: 'cog',        link: '/services' },
  { title: 'About Us',    description: 'Learn about Aurelia and our approach.',   icon: 'info',       link: '/about' },
  { title: 'Contact',     description: 'Book a free digital maturity assessment.', icon: 'email',     link: '/contact' },
];

const seo = {
  title:       'Page Not Found — Aurelia Automation & IT Services',
  description: "This page doesn't exist. Return home or explore our industrial automation services.",
};

const schema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  inLanguage: 'en',
  '@id': Astro.url.href,
  url: Astro.url.href,
  name: 'Page Not Found',
  description: seo.description,
  isPartOf: {
    '@type': 'WebSite',
    url: `${Astro.site}`,
    name: 'Aurelia Automation & IT Services',
  },
};
---

<BaseLayout seo={seo} schema={schema}>
  <section class="grid min-h-full place-items-center px-6 pt-32 pb-10 sm:pt-48 lg:px-8">
    <div class="text-center">
      <p class="text-xl font-semibold text-brand-600">{page.errorCode}</p>
      <h1 class="mt-4 text-4xl text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl">{page.title}</h1>
      <p class="mt-6 text-lg font-medium text-pretty text-slate-500 sm:text-xl/8">{page.description}</p>
    </div>

    <div class="mx-auto w-full px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
      <div class="mx-auto w-full max-w-lg">
        <ul class="divide-y divide-dashed divide-slate-200">
          {quickLinks.map(item => (
            <li>
              <a href={item.link} class="group flex gap-x-5 px-2 py-7 rounded-lg transition hover:bg-brand-50">
                <Icon name={item.icon} class="size-6 text-brand-600 mt-0.5" />
                <div class="grow">
                  <h3 class="font-semibold text-slate-700 group-hover:text-brand-700 transition-colors">{item.title}</h3>
                  <p class="mt-0.5 text-sm text-slate-500">{item.description}</p>
                </div>
                <Icon name="chevronRight" class="self-center text-slate-400 transition group-hover:translate-x-1" />
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="mt-6 flex items-center justify-center">
        <Button id="go-back" variant="primary">{page.goBackLabel}</Button>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('astro:page-load', () => {
      document.getElementById('go-back')?.addEventListener('click', () => history.back());
    });
  </script>
</BaseLayout>
