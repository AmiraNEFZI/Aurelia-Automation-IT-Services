---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Button from '@ui/Button.astro';
import Icon from '@ui/icons/Icon.astro';
import type { WithContext, Thing } from 'schema-dts';

const services = [
  {
    icon: 'cog',
    title: 'Industrial Automation',
    tagline: 'Robotics · PLCs · SCADA',
    description:
      'Installation and maintenance of robotic systems, PLCs and SCADA networks, ensuring efficient production and reduced downtime across your entire facility.',
    features: [
      'Robotic system design, installation & commissioning',
      'PLC programming (Siemens, Allen-Bradley, Schneider…)',
      'SCADA network architecture & supervision',
      'Predictive maintenance & downtime reduction',
      'Legacy system modernisation & upgrades',
    ],
    color: 'brand',
  },
  {
    icon: 'brain',
    title: 'IoT & AI Integration',
    tagline: 'Connected Machines · Smart Decisions',
    description:
      'Deployment of IoT and artificial intelligence solutions to modernise industrial processes, improve data collection and facilitate informed decision-making.',
    features: [
      'IoT sensor network design & deployment',
      'Real-time machine data collection & monitoring',
      'AI/ML models for anomaly detection & predictive analytics',
      'Edge computing & cloud integration',
      'Centralised operations dashboard',
    ],
    color: 'teal',
  },
  {
    icon: 'presentationChart',
    title: 'Power BI Consulting',
    tagline: 'Data · Dashboards · Decisions',
    description:
      'Designing customised, interactive dashboards, transforming raw data into strategic information for better performance management.',
    features: [
      'Custom Power BI dashboard design & development',
      'Data modelling, KPI definition & DAX optimisation',
      'ERP/MES/SCADA data connectors',
      'Automated reporting & performance tracking',
      'User training & ongoing dashboard support',
    ],
    color: 'brand',
  },
];

const colorMap: Record<string, string> = {
  brand: 'bg-brand-100 text-brand-700',
  teal:  'bg-teal-100 text-teal-700',
};
const borderMap: Record<string, string> = {
  brand: 'hover:border-brand-400',
  teal:  'hover:border-teal-400',
};

const seo = {
  title: 'Services — Aurelia Automation & IT Services',
  description: 'Industrial automation, IoT/AI integration and Power BI consulting services for automotive, pharma, energy, agri-food and logistics.',
};

const schema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  inLanguage: 'en',
  '@id': Astro.url.href,
  url: Astro.url.href,
  name: 'Services — Aurelia Automation & IT Services',
  description: seo.description,
  isPartOf: {
    '@type': 'WebSite',
    url: `${Astro.site}`,
    name: 'Aurelia Automation & IT Services',
  },
};
---

<BaseLayout seo={seo} schema={schema}>
  <!-- Header -->
  <section class="mx-auto max-w-[85rem] px-4 pt-48 pb-12 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-3xl lg:mx-0">
      <h1 class="text-4xl text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl">Our Services</h1>
      <p class="mt-6 text-lg font-medium text-pretty text-slate-700 sm:text-xl/8">
        Three integrated service pillars built to turn your industrial operations into a connected, agile and profit-generating ecosystem.
      </p>
    </div>
  </section>

  <!-- Services cards -->
  <section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8 lg:py-16">
    <div class="grid grid-cols-1 gap-8 md:grid-cols-3">
      {services.map(s => (
        <div class={`group relative flex flex-col rounded-2xl border border-dashed border-slate-300 p-8 transition-all duration-300 hover:shadow-xl bg-white ${borderMap[s.color]}`}>
          <div class="pointer-events-none absolute inset-0 rounded-2xl bg-linear-to-b/oklch from-slate-50 to-transparent opacity-0 transition duration-300 group-hover:opacity-100"/>
          <div class={`relative z-10 mb-4 flex h-12 w-12 items-center justify-center rounded-xl ${colorMap[s.color]}`}>
            <Icon name={s.icon} class="size-6"/>
          </div>
          <p class={`relative z-10 mb-1 text-xs font-bold uppercase tracking-widest ${s.color === 'teal' ? 'text-teal-600' : 'text-brand-500'}`}>{s.tagline}</p>
          <h2 class="relative z-10 mb-3 text-xl font-bold text-slate-800">{s.title}</h2>
          <p class="relative z-10 mb-5 text-sm text-pretty text-slate-600 grow">{s.description}</p>
          <ul class="relative z-10 space-y-2">
            {s.features.map(f => (
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class={`mt-0.5 size-4 shrink-0 ${s.color === 'teal' ? 'text-teal-600' : 'text-brand-600'}`} fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                </svg>
                {f}
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </section>

  <!-- Sectors badge row -->
  <section class="mx-auto max-w-[85rem] px-4 pb-10 sm:px-6 lg:px-8">
    <p class="mb-4 text-sm font-semibold uppercase tracking-widest text-slate-500">Sectors we serve</p>
    <div class="flex flex-wrap gap-3">
      {['Automotive','Pharmaceuticals','Energy','Agri-food','Logistics'].map(s => (
        <span class="rounded-full border border-teal-400 bg-teal-50 px-4 py-1.5 text-sm font-medium text-teal-800">{s}</span>
      ))}
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-16">
    <div class="relative overflow-hidden rounded-3xl bg-brand-700 px-8 py-14 text-center sm:px-16">
      <svg viewBox="0 0 1024 1024" class="absolute top-1/2 left-1/2 -z-10 size-[64rem] -translate-x-1/2 -translate-y-1/2 opacity-20" aria-hidden="true">
        <circle cx="512" cy="512" r="512" fill="url(#cta2)"/>
        <defs><radialGradient id="cta2"><stop offset="0" stop-color="#1B3A7A"/><stop offset="1" stop-color="#2E8B57"/></radialGradient></defs>
      </svg>
      <h2 class="relative text-2xl font-semibold text-white sm:text-3xl md:text-4xl">Have a project in mind?</h2>
      <p class="relative mt-4 text-brand-100 max-w-xl mx-auto">
        Our team is ready to analyse your needs and deliver the right solution — book your free digital maturity assessment today.
      </p>
      <div class="relative mt-8">
        <Button href="/contact" variant="tertiary" className="inline-flex border-none px-6! text-brand-800 font-semibold">
          Book Free Assessment
        </Button>
      </div>
    </div>
  </section>
</BaseLayout>
