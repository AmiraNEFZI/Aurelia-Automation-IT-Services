---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Button from '@ui/Button.astro';
import type { WithContext, Thing } from 'schema-dts';

const expertise = [
  {
    num: '01',
    title: 'Automatisation industrielle',
    color: 'brand',
    items: [
      'Conception, installation et optimisation de systèmes automatisés',
      'Programmation et mise en service de PLC et robots industriels',
      'Supervision HMI/SCADA et contrôle avancé des processus',
      'Maintenance, modernisation et retrofit d\'équipements existants',
    ],
  },
  {
    num: '02',
    title: 'Digitalisation & IT industrielle',
    color: 'teal',
    items: [
      'Déploiement de solutions IoT, MES et ERP',
      'Intégration de systèmes cloud et edge computing',
      'Supervision et contrôle à distance des opérations',
    ],
  },
  {
    num: '03',
    title: 'Cybersécurité & IT',
    color: 'brand',
    items: [
      'Protection des infrastructures IT et OT',
      'Sécurisation des données et des communications',
      'Audit, gouvernance et conformité aux standards de sécurité',
      'Stratégies de cybersécurité adaptées aux besoins industriels et IT',
    ],
  },
  {
    num: '04',
    title: 'Exploitation et valorisation des données',
    color: 'teal',
    items: [
      'Collecte et traitement des données en temps réel',
      'Analyse avancée pour optimisation de production et réduction des coûts',
      'Tableaux de bord, KPI et indicateurs de performance personnalisés',
      'Prévision et maintenance prédictive',
    ],
  },
  {
    num: '05',
    title: 'Conseil et accompagnement stratégique',
    color: 'brand',
    items: [
      'Audit industriel et digital maturity assessment',
      'Identification des axes d\'optimisation et d\'innovation',
      'Accompagnement pour la transformation digitale et la transition vers l\'Industrie 4.0',
      'Formation et montée en compétences des équipes',
    ],
  },
];

const technologies = {
  groups: [
    {
      title: 'Technologies & environnements',
      items: [
        'Automatisation industrielle : PLC, HMI, SCADA, réseaux industriels',
        'Digitalisation & IT : IoT, MES, ERP, Cloud, Edge Computing',
        'Data & intelligence : analyse de données, tableaux de bord, KPI, modèles prédictifs',
        'Cybersécurité : sécurisation des infrastructures IT & OT, gouvernance et conformité',
      ],
    },
    {
      title: 'Approche technologique',
      items: [
        'Solutions interopérables et évolutives',
        'Respect des standards internationaux',
        'Intégration fluide avec les systèmes existants',
        'Orientation performance, sécurité et durabilité',
      ],
    },
    {
      title: 'Partenariats stratégiques',
      items: [
        'Collaboration avec des éditeurs et fournisseurs de solutions industrielles et IT',
        'Partenariats technologiques pour le déploiement de solutions ERP, IoT, supervision et data',
        'Coopérations orientées innovation, R&D et transfert de compétences',
      ],
    },
  ],
};

const seo = {
  title: 'Services — Aurelia Automation & IT Services',
  description: 'Automatisation industrielle, digitalisation, cybersécurité, exploitation des données et conseil stratégique. Représentant exclusif ERP LogieMAX en Afrique du Nord.',
};
const schema: WithContext<Thing> = {
  '@context': 'https://schema.org', '@type': 'WebPage',
  inLanguage: 'fr', '@id': Astro.url.href, url: Astro.url.href,
  name: seo.title,
  isPartOf: { '@type': 'WebSite', url: `${Astro.site}`, name: 'Aurelia Automation & IT Services' },
};
---

<BaseLayout seo={seo} schema={schema}>

  <!-- Header -->
  <section class="mx-auto max-w-[85rem] px-4 pt-44 pb-12 sm:px-6 lg:px-8">
    <div class="max-w-3xl">
      <h1 class="text-4xl font-bold text-slate-800 sm:text-5xl md:text-6xl">
        Nos domaines<br/><span class="text-brand-700">d'expertise</span>
      </h1>
      <p class="mt-6 text-lg text-slate-600">
        Aurelia accompagne les entreprises dans toute la chaîne de transformation industrielle et digitale,
        grâce à une expertise pointue et des solutions sur mesure.
      </p>
    </div>
  </section>

  <!-- 5 Expertise domains -->
  <section class="mx-auto max-w-[85rem] px-4 py-8 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3">
      {expertise.map(e => (
        <div class={`group relative rounded-2xl border p-8 bg-white shadow-sm hover:shadow-xl transition-all duration-300 ${e.color === 'teal' ? 'border-teal-200 hover:border-teal-400' : 'border-brand-200 hover:border-brand-400'}`}>
          <div class={`absolute top-0 left-0 w-1.5 h-full rounded-l-2xl ${e.color === 'teal' ? 'bg-teal-500' : 'bg-brand-700'}`}></div>
          <span class={`text-4xl font-black ${e.color === 'teal' ? 'text-teal-100' : 'text-brand-100'}`}>{e.num}</span>
          <h2 class={`mt-2 mb-4 text-lg font-bold ${e.color === 'teal' ? 'text-teal-700' : 'text-brand-700'}`}>{e.title}</h2>
          <ul class="space-y-2">
            {e.items.map(item => (
              <li class="flex items-start gap-2 text-sm text-slate-600">
                <svg class={`mt-0.5 size-4 shrink-0 ${e.color === 'teal' ? 'text-teal-600' : 'text-brand-600'}`} fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.75l6 6 9-13.5"/>
                </svg>
                {item}
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- LogieMAX card — spans remaining space -->
      <div class="group relative rounded-2xl border border-[#F2C811]/60 bg-white p-8 shadow-sm hover:shadow-xl transition-all duration-300 md:col-span-2 lg:col-span-1">
        <div class="absolute top-0 left-0 w-1.5 h-full rounded-l-2xl bg-[#F2C811]"></div>
        <div class="mb-4 flex items-center gap-3">
          <span class="rounded-lg bg-[#F2C811]/20 px-3 py-1 text-xs font-bold text-slate-700 uppercase tracking-widest">Partenariat exclusif</span>
        </div>
        <h2 class="text-lg font-bold text-slate-800 mb-2">Représentation ERP — LogieMAX</h2>
        <p class="text-sm font-semibold text-brand-700 mb-4">
          Aurelia est représentant officiel et exclusif de la solution ERP LogieMAX en Afrique du Nord.
        </p>
        <ul class="space-y-2 mb-4">
          {[
            'Commercialisation de la solution ERP LogieMAX',
            'Intégration et déploiement selon les besoins des entreprises',
            'Accompagnement fonctionnel et technique',
            'Support et formation des utilisateurs',
          ].map(item => (
            <li class="flex items-start gap-2 text-sm text-slate-600">
              <svg class="mt-0.5 size-4 shrink-0 text-[#F2C811]" fill="currentColor" viewBox="0 0 24 24">
                <path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.77 5.82 21 7 14.14 2 9.27l6.91-1.01z"/>
              </svg>
              {item}
            </li>
          ))}
        </ul>
        <p class="text-xs text-slate-500">
          LogieMAX est une solution ERP &amp; CRM complète, conçue pour optimiser la gestion,
          renforcer la visibilité des processus et soutenir la performance opérationnelle,
          avec accès web et mobile.
        </p>
      </div>
    </div>
  </section>

  <!-- Technologies & Partenariats -->
  <section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8">
    <div class="rounded-3xl bg-slate-50 border border-slate-200 p-8 md:p-12">
      <h2 class="text-2xl font-bold text-slate-800 mb-2">Partenariats &amp; technologies</h2>
      <p class="text-slate-600 mb-8 max-w-2xl">
        Aurelia s'appuie sur des partenariats stratégiques et des technologies éprouvées pour garantir
        des solutions fiables, évolutives et alignées avec les standards industriels et IT.
      </p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
        {technologies.groups.map(g => (
          <div>
            <h3 class="font-bold text-brand-700 mb-3 text-sm uppercase tracking-wide">{g.title}</h3>
            <ul class="space-y-2">
              {g.items.map(item => (
                <li class="flex items-start gap-2 text-sm text-slate-600">
                  <span class="mt-1.5 size-1.5 shrink-0 rounded-full bg-brand-500"></span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-[85rem] px-4 py-12 sm:px-6 lg:px-8">
    <div class="relative overflow-hidden rounded-3xl bg-brand-700 px-8 py-14 text-center sm:px-16">
      <h2 class="relative text-2xl font-semibold text-white sm:text-3xl">Vous avez un projet ?</h2>
      <p class="relative mt-4 text-brand-100 max-w-xl mx-auto">
        Notre équipe est disponible pour analyser vos besoins et vous proposer la solution la mieux adaptée.
      </p>
      <div class="relative mt-8">
        <Button href="/contact" variant="tertiary" className="inline-flex border-none px-6! font-semibold text-brand-800">
          Demander une évaluation gratuite
        </Button>
      </div>
    </div>
  </section>

</BaseLayout>
