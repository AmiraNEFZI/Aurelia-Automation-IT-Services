---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import ContactForm from '@ui/forms/ContactForm.astro';
import type { WithContext, Thing } from 'schema-dts';

const seo = {
  title: 'Contact — Aurelia Automation & IT Services',
  description: 'Contactez Aurelia pour vos projets d\'automatisation industrielle, IoT/IA, Power BI ou une évaluation gratuite de maturité digitale.',
};
const schema: WithContext<Thing> = {
  '@context': 'https://schema.org', '@type': 'ContactPage',
  inLanguage: 'fr', '@id': Astro.url.href, url: Astro.url.href,
  name: 'Contact — Aurelia Automation & IT Services',
  isPartOf: { '@type': 'WebSite', url: `${Astro.site}`, name: 'Aurelia Automation & IT Services' },
};
---
<BaseLayout seo={seo} schema={schema}>
  <div class="mx-auto max-w-[85rem] px-4 pt-44 pb-28 sm:px-6 lg:px-8">

    <div class="mb-12 max-w-3xl">
      <h1 class="text-4xl font-bold text-slate-800 sm:text-5xl md:text-6xl">
        Entrez en contact<br/><span class="text-brand-700">avec nous.</span>
      </h1>
      <p class="mt-4 text-lg text-slate-600">Questions, projets ou évaluation gratuite de maturité digitale — nous sommes disponibles.</p>
    </div>

    <div class="grid grid-cols-1 gap-12 md:grid-cols-2 lg:gap-20">

      <!-- Form -->
      <div class="rounded-2xl bg-brand-700 overflow-hidden">
        <ContactForm />
      </div>

      <!-- Contact details -->
      <div class="space-y-10">

        <!-- Email -->
        <div class="flex gap-x-5">
          <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-brand-50">
            <svg class="size-6 text-brand-700" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75"/>
            </svg>
          </div>
          <div>
            <h4 class="font-semibold text-slate-800 mb-1">Email</h4>
            <a href="mailto:kachouti.adam@aurelia-itautomation.com" class="block text-brand-700 hover:underline text-sm">kachouti.adam@aurelia-itautomation.com</a>
            <a href="mailto:hassen.kachouti@aurelia-itautomation.com" class="block text-brand-700 hover:underline text-sm">hassen.kachouti@aurelia-itautomation.com</a>
          </div>
        </div>

        <!-- Phone -->
        <div class="flex gap-x-5">
          <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-teal-50">
            <svg class="size-6 text-teal-700" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 002.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 01-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 00-1.091-.852H4.5A2.25 2.25 0 002.25 4.5v2.25z"/>
            </svg>
          </div>
          <div>
            <h4 class="font-semibold text-slate-800 mb-1">Appelez-nous</h4>
            <a href="tel:+21655439968" class="block text-slate-600 hover:text-brand-700 text-sm">+216 55 439 968</a>
            <a href="tel:+21658972839" class="block text-slate-600 hover:text-brand-700 text-sm">+216 58 972 839</a>
          </div>
        </div>

        <!-- LinkedIn -->
        <div class="flex gap-x-5">
          <div class="flex size-12 shrink-0 items-center justify-center rounded-full bg-brand-50">
            <svg class="size-6 text-brand-700" fill="currentColor" viewBox="0 0 24 24">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </div>
          <div>
            <h4 class="font-semibold text-slate-800 mb-1">LinkedIn</h4>
            <a href="https://www.linkedin.com/company/aurelia-automation-it-services/" target="_blank" rel="noopener noreferrer" class="text-brand-700 hover:underline text-sm">aurelia-automation-it-services</a>
          </div>
        </div>

        <!-- Free assessment box -->
        <div class="rounded-2xl bg-brand-50 border border-brand-200 p-6">
          <h4 class="font-bold text-brand-700 text-lg mb-2">Évaluation de maturité digitale gratuite</h4>
          <p class="text-sm text-slate-600">Pas sûr par où commencer ? Nous offrons une évaluation gratuite et sans engagement pour identifier vos opportunités d'automatisation et d'intégration.</p>
          <p class="mt-3 text-sm font-semibold text-teal-700">→ Notre équipe vous contacte sous 24h.</p>
        </div>

      </div>
    </div>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      const ta = document.querySelector('#input-message') as HTMLTextAreaElement;
      if (!ta) return;
      const resize = () => { ta.style.height = 'auto'; ta.style.height = `${ta.scrollHeight + 3}px`; };
      resize();
      ta.addEventListener('input', resize);
    });
  </script>
</BaseLayout>
