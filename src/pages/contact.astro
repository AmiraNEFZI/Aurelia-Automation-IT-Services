---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Icon from '@ui/icons/Icon.astro';
import ContactForm from '@ui/forms/ContactForm.astro';
import type { WithContext, Thing } from 'schema-dts';

const title    = 'Contact Us';
const subTitle = 'Questions, projects or a free digital maturity assessment — we are here.';

const contactDetails = {
  addressLine1: 'Algeria',
  phone:        '+213 (0) XX XX XX XX',
  email:        'contact@aurelia-it.com',
};

const seo = {
  title: 'Contact — Aurelia Automation & IT Services',
  description: 'Contact Aurelia for industrial automation projects, IoT/AI integration, Power BI consulting or a free digital maturity assessment.',
};

const schema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  inLanguage: 'en',
  '@id': Astro.url.href,
  url: Astro.url.href,
  name: 'Contact — Aurelia Automation & IT Services',
  description: seo.description,
  isPartOf: { '@type': 'WebSite', url: `${Astro.site}`, name: 'Aurelia Automation & IT Services' },
};
---

<BaseLayout seo={seo} schema={schema}>
  <div class="mx-auto max-w-[85rem] px-4 pt-48 pb-28 sm:px-6 lg:px-8">
    <div class="mb-10 max-w-3xl lg:mb-14">
      <h2 class="text-4xl text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl">{title}</h2>
      <p class="mt-2 ml-1 text-slate-600">{subTitle}</p>
    </div>

    <div class="grid grid-cols-1 gap-x-10 md:grid-cols-2 lg:gap-x-16">
      <!-- Form -->
      <div class="mb-10 h-fit rounded-xl bg-brand-700 pb-10 md:order-2 md:mb-0 md:pb-0">
        <ContactForm />
      </div>

      <!-- Info -->
      <div class="space-y-12">
        <div class="flex gap-x-5">
          <Icon name="mapPin" />
          <div class="grow">
            <h4 class="font-semibold text-slate-600">Our address</h4>
            <address class="mt-1 text-sm text-slate-500 not-italic">{contactDetails.addressLine1}</address>
          </div>
        </div>

        <div class="flex gap-x-5">
          <Icon name="email" class="size-6 shrink-0 text-slate-600" />
          <div class="grow">
            <h4 class="font-semibold text-slate-600">Email us</h4>
            <a class="mt-1 text-sm text-slate-500 hover:text-slate-400 transition-colors" href={`mailto:${contactDetails.email}`}>{contactDetails.email}</a>
          </div>
        </div>

        <div class="flex gap-x-5">
          <Icon name="mobile" class="size-6 shrink-0 text-slate-600" />
          <div class="grow">
            <h4 class="font-semibold text-slate-600">Call us</h4>
            <a class="mt-1 text-sm text-slate-500 hover:text-slate-400 transition-colors" href={`tel:${contactDetails.phone.replace(/\s/g,'')}`}>{contactDetails.phone}</a>
          </div>
        </div>

        <!-- Free assessment highlight -->
        <div class="rounded-2xl bg-brand-50 border border-brand-200 p-6">
          <h4 class="font-bold text-brand-700 text-lg mb-2">Free Digital Maturity Assessment</h4>
          <p class="text-sm text-slate-600">
            Not sure where to start? We offer a free, no-obligation digital maturity assessment to help you identify automation and integration opportunities in your operations.
          </p>
          <p class="mt-3 text-sm font-medium text-teal-700">→ Our team will contact you within 24 hours.</p>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener('astro:page-load', () => {
      const ta = document.querySelector('#input-message') as HTMLTextAreaElement;
      if (!ta) return;
      const resize = () => { ta.style.height = 'auto'; ta.style.height = `${ta.scrollHeight + 3}px`; };
      resize();
      ta.addEventListener('input', resize);
    });
  </script>
</BaseLayout>
