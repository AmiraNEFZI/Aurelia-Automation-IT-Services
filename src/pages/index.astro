---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import Hero from '@sections/HeroSection.astro';
import FeatureShowcase from '@sections/FeatureShowcase.astro';
import FeatureAnimated from '@sections/FeatureAnimated.astro';
import FeatureGrid from '@sections/FeatureGrid.astro';
import Partners from '@sections/Partners.astro';
import CTA from '@sections/CTA.astro';

const seo = {
  title: 'Aurelia Automation & IT Services — Industrie 4.0 en Tunisie & Afrique du Nord',
  description: 'Piloter l\'efficacité, accroître la productivité, révéler la puissance des données. Automatisation industrielle, IoT/IA, Power BI et ERP LogieMAX.',
};
---

<BaseLayout seo={seo}>
  <Hero />
  <FeatureShowcase />
  <FeatureAnimated />
  <FeatureGrid />
  <Partners />
  <CTA />
</BaseLayout>
