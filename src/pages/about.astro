---
export const prerender = true;
import BaseLayout from '@layout/BaseLayout.astro';
import type { WithContext, Thing } from 'schema-dts';

const hero = {
  title: 'Aurelia Automation & IT Services',
  description:
    'We offer tailor-made automation and IT integration solutions aimed at optimising operational performance and ensuring sustainable competitiveness. Our independent and innovative approach enables us to meet the requirements of a wide range of sectors.',
  stats: [
    { label: 'Industrial sectors served',  value: '5+' },
    { label: 'Company type',               value: 'Partnership' },
    { label: 'Team size',                  value: '2–10' },
    { label: 'Commitment',                 value: 'Industry 4.0' },
  ],
};

const expertise = {
  title: 'Our expertise:',
  items: [
    {
      title: 'Industrial Automation:',
      description:
        'Installation and maintenance of robotic systems, PLCs and SCADA networks, ensuring efficient production and reduced downtime.',
    },
    {
      title: 'Advanced Technology Integration:',
      description:
        'Deployment of IoT and artificial intelligence solutions to modernise industrial processes, improve data collection and facilitate informed decision-making.',
    },
    {
      title: 'Power BI Consulting:',
      description:
        'Designing customised, interactive dashboards, transforming raw data into strategic information for better performance management.',
    },
  ],
};

const sectors = [
  'Automotive',
  'Pharmaceuticals',
  'Energy',
  'Agri-food',
  'Logistics',
];

const values = [
  { title: 'Independent',   description: 'No vendor lock-in — we select the right technology for your specific context.' },
  { title: 'Innovative',    description: 'We stay ahead of Industry 4.0 trends and apply them pragmatically to real operations.' },
  { title: 'Safety-First',  description: 'Every solution we deploy is designed to improve productivity while protecting people.' },
  { title: 'Ethical',       description: 'Responsible, transparent and sustainable technology decisions, every time.' },
];

const seo = {
  title: 'About — Aurelia Automation & IT Services',
  description: 'Aurelia: tailor-made industrial automation, IoT/AI integration and Power BI consulting for automotive, pharma, energy, agri-food and logistics sectors.',
};

const schema: WithContext<Thing> = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  inLanguage: 'en',
  '@id': Astro.url.href,
  url: Astro.url.href,
  name: 'About — Aurelia Automation & IT Services',
  description: seo.description,
  isPartOf: {
    '@type': 'WebSite',
    url: `${Astro.site}`,
    name: 'Aurelia Automation & IT Services',
    description: 'Tailor-made industrial automation and IT integration solutions.',
  },
};
---

<BaseLayout seo={seo} schema={schema}>
  <!-- Hero -->
  <section class="mx-auto max-w-[85rem] px-4 pt-48 pb-12 sm:px-6 lg:px-8">
    <div class="max-w-7xl">
      <div class="mx-auto max-w-2xl lg:mx-0">
        <h1 class="text-4xl text-balance text-slate-800 sm:text-5xl md:text-6xl lg:text-7xl">{hero.title}</h1>
        <p class="mt-8 text-lg font-medium text-pretty text-slate-700 sm:text-xl/8">{hero.description}</p>
      </div>
      <div class="mx-auto mt-10 max-w-2xl lg:mx-0 lg:max-w-none">
        <dl class="mt-16 grid grid-cols-1 gap-8 sm:mt-20 sm:grid-cols-2 lg:grid-cols-4">
          {hero.stats.map(stat => (
            <div class="flex flex-col-reverse gap-1">
              <dt class="text-base/7 text-slate-600">{stat.label}</dt>
              <dd class="text-3xl font-semibold tracking-tight text-brand-700">{stat.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Expertise -->
  <section class="mx-auto max-w-[85rem] px-4 py-24 sm:px-6 lg:px-8 lg:py-32">
    <div class="group relative isolate overflow-hidden rounded-3xl bg-brand-50 border border-brand-100 p-5 sm:p-11">
      <div class="svgBlock mx-auto max-w-7xl">
        <h2 class="relative pl-4 text-2xl font-semibold text-balance text-brand-800 md:text-3xl md:leading-tight border-l-4 border-teal-500">
          {expertise.title}
        </h2>
        <dl class="relative mt-10 grid max-w-xl grid-cols-1 items-start text-base/7 text-slate-600 sm:max-w-none lg:grid-flow-row-dense lg:auto-rows-fr lg:grid-cols-3">
          {expertise.items.map((item, index) => (
            <div class={`px-5 py-5 sm:px-10 lg:py-0 ${index === 1 ? 'h-full border-y border-dashed border-brand-200 lg:border-x lg:border-y-0' : ''}`}>
              <dt class="text-lg font-semibold text-balance text-brand-700">{item.title}</dt>
              <dd class="mt-2 text-pretty text-slate-600">{item.description}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <!-- Sectors -->
  <section class="mx-auto max-w-[85rem] px-4 pb-16 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-semibold text-slate-800 md:text-3xl mb-8">Sectors we serve</h2>
    <div class="flex flex-wrap gap-3">
      {sectors.map(s => (
        <span class="rounded-full border border-teal-400 bg-teal-50 px-5 py-2 text-sm font-semibold text-teal-800 transition hover:bg-teal-500 hover:text-white duration-200">
          {s}
        </span>
      ))}
    </div>
  </section>

  <!-- Values -->
  <section class="mx-auto max-w-[85rem] px-4 pb-24 sm:px-6 lg:px-8">
    <h2 class="text-2xl font-semibold text-slate-800 md:text-3xl mb-10">Our values</h2>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {values.map(v => (
        <div class="rounded-2xl border border-dashed border-brand-200 p-6 hover:border-brand-500 hover:shadow-md transition-all duration-300 bg-white">
          <h3 class="font-semibold text-brand-700 text-lg mb-2">{v.title}</h3>
          <p class="text-slate-600 text-sm">{v.description}</p>
        </div>
      ))}
    </div>
  </section>

  <style>
    .svgBlock::after {
      content: '';
      position: absolute;
      inset: 0;
      background-image: url(/guilloche.svg);
      background-repeat: repeat;
      background-position: right top;
      background-size: 20px;
      opacity: 0.06;
      mask-image: linear-gradient(270deg, rgb(0,0,0), rgba(0,0,0,0));
      pointer-events: none;
    }
  </style>
</BaseLayout>
